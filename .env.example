# Set by Next.js. Leave this empty. npm run seed refuses to run when it is production
# (full seed allows --force / SEED_FORCE=1 only on a disposable database).
NODE_ENV=

# Required. MongoDB connection string. There is no localhost fallback.
MONGODB_URI=

# Required. Session signing secret. Generate one locally; do not commit it.
AUTH_SECRET=

# Required. Canonical site URL. Auth.js does not trust the Host header instead. Locally this is http://localhost:3000.
# Also used for public canonical and Open Graph URLs.
AUTH_URL=

# Optional alias, used only when AUTH_SECRET is unset.
NEXTAUTH_SECRET=

# Optional alias, used only when AUTH_URL is unset.
NEXTAUTH_URL=

# Required for npm run seed. Never set these in production.
ADMIN_EMAIL=

# Required for npm run seed. Min 10 chars, letter + number. The command does not print this value.
ADMIN_PASSWORD=

# Optional. Set to 1 only with npm run seed -- --force on a disposable DB when NODE_ENV=production.
SEED_FORCE=

# Required to call GET /api/health. Send the same value in the x-health-token header. The route stays hidden until this is set.
HEALTH_CHECK_SECRET=

# AI backend: ollama (default, free local) | huggingface (paid Inference Providers) | off
AI_PROVIDER=ollama

# Ollama base URL when AI_PROVIDER=ollama. Defaults to http://127.0.0.1:11434 if unset.
# Next.js must run on the same machine (or be able to reach this host). Dockerized apps often need host.docker.internal.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Ollama chat model for title/content polish and analysis. Pull it first: ollama pull llama3.2
# Smaller alternatives: llama3.2:1b, qwen2.5:3b, gemma2:2b, phi3:mini
OLLAMA_TEXT_MODEL=llama3.2

# Optional. Hugging Face writing polish, analysis, and cover generation when AI_PROVIDER=huggingface.
# Token needs Inference Providers permission (uses paid credits). HF_TOKEN is accepted as an alias when this is unset.
HUGGINGFACE_API_KEY=

# Optional alias used only when HUGGINGFACE_API_KEY is unset (matches Hugging Face docs).
HF_TOKEN=

# Optional. Chat model id for title/content polish (OpenAI-compatible router). Defaults to Qwen/Qwen3-4B-Instruct-2507.
HF_TEXT_MODEL=

# Optional. Text-to-image model id for cover generation. Defaults to black-forest-labs/FLUX.1-schnell.
HF_IMAGE_MODEL=

# Optional. Positive integer daily image-generation cap per user. Cover AI stays off until this is set with AI_PROVIDER=huggingface (API returns 503).
# Local Ollama does not support cover generation; upload a cover instead.
HF_IMAGE_DAILY_QUOTA=

# Optional. Name of the one proxy header trusted for a client address. The address is stored only as a salted hash.
TRUSTED_PROXY_HEADER=

# Optional. SMTP host. Mail is not sent unless this and EMAIL_FROM are both set.
SMTP_HOST=

# Optional. From address for verification and password-reset mail. Required together with SMTP_HOST.
EMAIL_FROM=

# Optional. SMTP port. Defaults to 587 when unset.
SMTP_PORT=

# Optional. SMTP username. Leave empty when the server does not require auth.
SMTP_USER=

# Optional. SMTP password. Used only when SMTP_USER is set.
SMTP_PASS=

# Optional. Browser API base. Defaults to /api when unset.
NEXT_PUBLIC_API_URL=

# Required to upload, display through next/image, or delete images. Cloudinary cloud name.
CLOUDINARY_CLOUD_NAME=

# Required to upload or delete images. Cloudinary API key. Stays on the server.
CLOUDINARY_API_KEY=

# Required to upload or delete images. Cloudinary API secret. Stays on the server.
CLOUDINARY_API_SECRET=

# Required when a rate-limited route runs (register, login, password reset, AI). Those routes fail if this is unset or Redis is unreachable.
REDIS_URL=
