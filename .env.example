# Required. There is no localhost fallback.
MONGODB_URI=

# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Required canonical URL. Auth.js will not trust the Host header in its place.
AUTH_URL=http://localhost:3000

# Optional aliases read when AUTH_SECRET / AUTH_URL are unset.
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=

# One-off admin bootstrap (`npm run seed:admin`). Refuses to run when NODE_ENV=production.
# Generate a password; do not commit one.
ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Health check. The endpoint stays hidden until this is set.
# Send it as the x-health-token header.
# HEALTH_CHECK_SECRET=

# Optional Hugging Face text features. Image generation stays disabled until HF_IMAGE_DAILY_QUOTA is a positive integer.
# HUGGINGFACE_API_KEY=
# HF_IMAGE_DAILY_QUOTA=

# Only this header is trusted for a client address, and only as a salted hash.
# View rows expire after 90 days. Raw IP addresses are not stored.
# TRUSTED_PROXY_HEADER=x-real-ip

# Optional object-storage host. When unset, images are served from /api/media as image bytes only.
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# Optional SMTP for verification and password-reset email.
# EMAIL_FROM=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
